{
	"name": "@talqo/api",
	"version": "0.0.0",
	"private": true,
	"type": "module",
	"scripts": {
		"build": "bun build src/index.ts src/db/migrate.ts --outdir dist --target bun",
		"db:generate": "drizzle-kit generate",
		"db:migrate": "bun run src/db/migrate.ts",
		"db:seed": "bun run src/db/seed.ts",
		"dev": "bun --watch src/index.ts",
		"openapi:generate": "bun --env-file .env.example --preload ./no-database.preload.ts src/openapi.ts",
		"test": "bun test --env-file .env.example --preload ./no-database.preload.ts --path-ignore-patterns '**/*.integration.test.ts'",
		"test:integration": "bun --env-file .env.example ../../scripts/test-integration.ts",
		"typecheck": "tsc --noEmit"
	},
	"dependencies": {
		"@ai-sdk/amazon-bedrock": "5.0.114",
		"@ai-sdk/anthropic": "4.0.79",
		"@ai-sdk/azure": "4.0.100",
		"@ai-sdk/google": "4.0.94",
		"@ai-sdk/mcp": "2.0.74",
		"@ai-sdk/mistral": "4.0.63",
		"@ai-sdk/openai": "4.0.92",
		"@ai-sdk/openai-compatible": "3.0.68",
		"@ai-sdk/provider": "4.0.27",
		"@azure/identity": "4.13.3",
		"@hono/zod-openapi": "1.6.3",
		"@talqo/shared": "workspace:*",
		"ai": "7.0.138",
		"drizzle-orm": "0.45.4",
		"hono": "4.13.13",
		"ipaddr.js": "2.5.0",
		"postgres": "3.4.9",
		"zod": "4.6.7"
	},
	"devDependencies": {
		"@talqo/typescript-config": "workspace:*",
		"@types/bun": "1.4.3",
		"drizzle-kit": "0.31.11",
		"typescript": "7.0.2"
	}
}
