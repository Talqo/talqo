{
	"name": "@talqo/api",
	"version": "0.0.0",
	"private": true,
	"type": "module",
	"scripts": {
		"build": "bun build src/index.ts --outdir dist --target bun",
		"db:generate": "drizzle-kit generate",
		"db:migrate": "bun run src/db/migrate.ts",
		"db:seed": "bun run src/db/seed.ts",
		"dev": "bun --watch src/index.ts",
		"openapi:generate": "bun --preload ./no-database.preload.ts src/openapi.ts",
		"test": "bun test --preload ./no-database.preload.ts --path-ignore-patterns '**/*.integration.test.ts'",
		"test:integration": "bun ../../scripts/test-integration.ts",
		"typecheck": "tsc --noEmit"
	},
	"dependencies": {
		"@ai-sdk/amazon-bedrock": "5.0.61",
		"@ai-sdk/anthropic": "4.0.41",
		"@ai-sdk/azure": "4.0.48",
		"@ai-sdk/google": "4.0.50",
		"@ai-sdk/mistral": "4.0.32",
		"@ai-sdk/openai": "4.0.46",
		"@ai-sdk/openai-compatible": "3.0.35",
		"@ai-sdk/provider": "4.0.7",
		"@azure/identity": "4.13.2",
		"@hono/zod-openapi": "1.6.1",
		"@talqo/shared": "workspace:*",
		"ai": "7.0.77",
		"drizzle-orm": "0.45.2",
		"hono": "4.13.3",
		"postgres": "3.4.9",
		"zod": "4.4.3"
	},
	"devDependencies": {
		"@talqo/typescript-config": "workspace:*",
		"@types/bun": "1.4.0",
		"drizzle-kit": "0.31.10",
		"typescript": "7.0.2"
	}
}
