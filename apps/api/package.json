{
	"name": "@talqo/api",
	"version": "0.0.0",
	"private": true,
	"type": "module",
	"scripts": {
		"build": "bun build src/index.ts src/db/migrate.ts --outdir dist --target bun",
		"coverage:overlap": "bash ../../scripts/supercov.sh -- bun run test --timeout 30000 --only-failures",
		"db:generate": "drizzle-kit generate",
		"db:migrate": "bun run src/db/migrate.ts",
		"db:seed": "bun run src/db/seed.ts",
		"dev": "bun --env-file .env.example --env-file .env --watch src/index.ts",
		"dev:setup": "bun --env-file .env.example --env-file .env src/db/migrate.ts && bun --env-file .env.example --env-file .env src/db/seed.ts",
		"openapi:generate": "bun --env-file .env.example --preload ./no-database.preload.ts src/openapi.ts",
		"test": "bun test --env-file .env.example --preload ./no-database.preload.ts --path-ignore-patterns '**/*.integration.test.ts'",
		"test:integration": "../../scripts/test-integration.sh",
		"typecheck": "bun check"
	},
	"dependencies": {
		"@ai-sdk/amazon-bedrock": "5.0.130",
		"@ai-sdk/anthropic": "4.0.94",
		"@ai-sdk/azure": "4.0.114",
		"@ai-sdk/google": "4.0.109",
		"@ai-sdk/mcp": "2.0.88",
		"@ai-sdk/mistral": "4.0.77",
		"@ai-sdk/openai": "4.0.106",
		"@ai-sdk/openai-compatible": "3.0.82",
		"@ai-sdk/provider": "4.0.35",
		"@azure/identity": "4.14.1",
		"@hono/zod-openapi": "1.6.3",
		"@talqo/shared": "workspace:*",
		"ai": "7.0.159",
		"drizzle-orm": "0.45.4",
		"hono": "4.13.16",
		"ipaddr.js": "2.5.0",
		"pino": "10.4.0",
		"postgres": "4.0.0",
		"zod": "4.6.7"
	},
	"devDependencies": {
		"@talqo/typescript-config": "workspace:*",
		"@types/bun": "1.4.4",
		"drizzle-kit": "0.31.11",
		"typescript": "7.0.2"
	}
}
