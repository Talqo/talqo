{
	"name": "@talqo/api",
	"version": "0.0.0",
	"private": true,
	"type": "module",
	"scripts": {
		"build": "bun build src/index.ts --outdir dist --target bun",
		"db:generate": "drizzle-kit generate",
		"db:migrate": "bun run src/db/migrate.ts",
		"db:seed": "bun run src/db/seed.ts",
		"dev": "bun --watch src/index.ts",
		"test": "bun test --path-ignore-patterns '**/*.integration.test.ts'",
		"test:integration": "bun ../../scripts/test-integration.ts",
		"typecheck": "tsc --noEmit"
	},
	"dependencies": {
		"@ai-sdk/amazon-bedrock": "^5.0.57",
		"@ai-sdk/anthropic": "^4.0.39",
		"@ai-sdk/azure": "^4.0.43",
		"@ai-sdk/google": "^4.0.45",
		"@ai-sdk/mistral": "^4.0.29",
		"@ai-sdk/openai": "^4.0.42",
		"@ai-sdk/openai-compatible": "^3.0.31",
		"@ai-sdk/provider": "^4.0.7",
		"@azure/identity": "^4.13.2",
		"@talqo/shared": "workspace:*",
		"ai": "^7.0.66",
		"drizzle-orm": "0.45.2",
		"hono": "4.13.2",
		"postgres": "3.4.9",
		"zod": "4.4.3"
	},
	"devDependencies": {
		"@talqo/typescript-config": "workspace:*",
		"@types/bun": "1.3.14",
		"drizzle-kit": "0.31.10",
		"typescript": "7.0.2"
	}
}
