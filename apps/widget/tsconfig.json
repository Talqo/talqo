{
	"extends": "@talqo/typescript-config/react-app.json",
	"compilerOptions": {
		"resolveJsonModule": true,
		"paths": {
			"@/*": ["./src/*"],
			"@talqo/sdk": ["../../packages/sdk/src/index.ts"]
		},
		"types": ["vite/client", "bun"]
	},
	"include": [
		"src/**/*.ts",
		"src/**/*.tsx",
		"vite.config.ts",
		"vite.loader.config.ts",
		"vite.css.ts",
		"i18next.config.ts"
	]
}
