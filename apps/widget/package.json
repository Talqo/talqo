{
	"name": "@talqo/widget",
	"version": "0.0.0",
	"private": true,
	"type": "module",
	"scripts": {
		"build": "vite build",
		"coverage:overlap": "bash ../../scripts/supercov.sh -- sh -c 'bun run build && bun test --only-failures' && bash ../../scripts/supercov-summary.sh",
		"dev": "bun --env-file .env.example node_modules/vite/bin/vite.js",
		"typecheck": "bun check",
		"test": "bun test",
		"i18n": "i18next-cli status && i18next-cli lint --quiet && i18next-cli extract --ci --dry-run --quiet",
		"i18n:fix": "i18next-cli extract --quiet && i18next-cli status && i18next-cli lint --quiet"
	},
	"dependencies": {
		"@talqo/sdk": "workspace:*",
		"@talqo/shared": "workspace:*",
		"@talqo/ui": "workspace:*",
		"i18next": "^26.6.0",
		"react": "19.3.1",
		"react-dom": "19.3.1",
		"react-i18next": "^17.1.9"
	},
	"devDependencies": {
		"@happy-dom/global-registrator": "^21.0.4",
		"@tailwindcss/vite": "4.3.3",
		"@talqo/typescript-config": "workspace:*",
		"@types/bun": "1.4.4",
		"@types/react": "19.3.0",
		"@types/react-dom": "19.3.0",
		"@vitejs/plugin-react": "6.1.2",
		"i18next-cli": "1.81.0",
		"postcss": "^8.5.32",
		"tailwindcss": "4.3.3",
		"typescript": "7.0.2",
		"vite": "8.3.5",
		"vite-plugin-css-injected-by-js": "5.0.3",
		"vite-plugin-svgr": "^5.2.0"
	}
}
