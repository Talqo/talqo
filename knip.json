{
	"$schema": "https://unpkg.com/knip@6/schema.json",
	"treatConfigHintsAsErrors": true,
	"ignoreBinaries": ["actionlint", "zizmor"],
	"ignoreDependencies": ["@playwright/cli"],
	"workspaces": {
		".": {
			"entry": ["*.ts"],
			"project": ["*.ts"]
		},
		"apps/api": {
			"entry": ["src/index.ts", "test-database.preload.ts"],
			"project": ["src/**/*.ts", "*.ts"]
		},
		"apps/docs": {
			"entry": ["src/components/mdx.tsx"],
			"project": ["src/**/*.{ts,tsx,css}", "content/**/*.mdx", "*.ts"],
			"ignoreIssues": {
				"src/lib/source.ts": ["unlisted"]
			}
		},
		"apps/e2e": {
			"project": ["**/*.ts"]
		},
		"apps/web": {
			"entry": ["i18next.config.ts"],
			"project": ["src/**/*.{ts,tsx,css}", "*.ts", "!src/api/generated/**"]
		},
		"apps/widget": {
			"entry": ["src/svg-stub-component.ts", "i18next.config.ts"],
			"project": ["src/**/*.{ts,tsx,css}", "*.ts"]
		},
		"packages/sdk": {
			"project": ["src/**/*.ts"],
			"ignoreDependencies": ["@talqo/typescript-config"],
			"ignoreIssues": {
				"src/generated/**": ["exports", "types", "duplicates"]
			}
		},
		"packages/ui": {
			"entry": ["i18next.config.ts", "src/components/*.tsx", "src/lib/*.ts"],
			"project": ["src/**/*.{ts,tsx,css}", "*.ts"]
		}
	}
}
