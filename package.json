{
	"name": "talqo",
	"version": "0.0.1",
	"private": true,
	"workspaces": [
		"apps/*",
		"packages/*"
	],
	"type": "module",
	"scripts": {
		"actions:check": "actionlint && zizmor --offline .",
		"build": "turbo run build",
		"ci": "bun run --sequential actions:check contracts:check quality knip i18n typecheck test build",
		"contracts:check": "bun run contracts:generate && ! git status --porcelain -- apps/api/openapi.json apps/web/src/api/generated packages/sdk/src/generated | grep .",
		"contracts:generate": "bun run --cwd apps/api openapi:generate && bun x orval --config orval.config.ts --fail-on-warnings",
		"dev": "bun scripts/dev.ts",
		"dev:docs": "turbo run dev --filter=@talqo/docs --ui=tui",
		"e2e": "turbo run e2e --output-logs=errors-only",
		"format": "bun fmt --check",
		"format:fix": "bun fmt",
		"i18n": "turbo run i18n --output-logs=errors-only",
		"i18n:fix": "turbo run i18n:fix --output-logs=errors-only",
		"knip": "knip --cache --cache-location .cache/knip",
		"lint": "oxlint --deny-warnings --report-unused-disable-directives .",
		"lint:fix": "oxlint --deny-warnings --report-unused-disable-directives --fix .",
		"pack:sdk": "bash scripts/pack-sdk.sh",
		"prepare": "husky",
		"push": "bash scripts/push-images.sh all",
		"push:docs": "bash scripts/push-images.sh docs",
		"push:talqo": "bash scripts/push-images.sh talqo",
		"quality": "turbo run lint format --output-logs=errors-only",
		"quality:fix": "turbo run lint:fix format:fix --output-logs=errors-only",
		"release": "bash scripts/release.sh",
		"test": "turbo run test --output-logs=errors-only",
		"test:integration": "turbo run test:integration --output-logs=errors-only",
		"typecheck": "turbo run typecheck --output-logs=errors-only"
	},
	"devDependencies": {
		"@commitlint/cli": "^21.2.3",
		"@commitlint/config-conventional": "^21.2.3",
		"@playwright/cli": "^0.1.22",
		"@shadcn/lint": "0.2.3",
		"@tanstack/eslint-plugin-router": "1.162.0",
		"@types/bun": "1.4.3",
		"eslint-plugin-playwright": "2.12.1",
		"husky": "^9.1.7",
		"knip": "6.41.0",
		"orval": "8.43.0",
		"oxlint": "1.88.0",
		"oxlint-tsgolint": "^7.0.2004",
		"turbo": "2.11.9"
	},
	"packageManager": "bun@1.4.4"
}
