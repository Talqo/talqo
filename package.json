{
	"name": "talqo",
	"version": "0.0.1",
	"private": true,
	"workspaces": [
		"apps/*",
		"packages/*"
	],
	"type": "module",
	"scripts": {
		"actions:check": "actionlint && zizmor --offline .",
		"build": "turbo run build",
		"check": "bun run typecheck && fallow audit --only dead-code,dupes --format compact --quiet",
		"ci": "bun run --sequential actions:check contracts:check quality dead-code duplication architecture i18n typecheck health build",
		"contracts:check": "bun run contracts:generate && ! git status --porcelain -- apps/api/openapi.json apps/web/src/api/generated packages/sdk/src/generated | grep .",
		"contracts:generate": "bun run --cwd apps/api openapi:generate && bun x orval --config orval.config.ts --fail-on-warnings",
		"cov": "supercov runs latest gaps",
		"cov:record": "supercov -- sh -c 'SUPERCOV_TEST_KIND=unit bun run test --force --concurrency=4 -- --timeout 60000 && SUPERCOV_TEST_KIND=integration bun run test:integration --force -- --timeout 60000' && supercov runs latest report --format istanbul --output .cache/coverage/coverage-final.json --force",
		"duplication": "fallow dupes --fail-on-issues --format compact --quiet",
		"architecture": "fallow architecture --fail-on-issues",
		"dead-code": "fallow dead-code --fail-on-issues",
		"health": "bun run cov:record && bun run health:check",
		"health:check": "fallow audit --only health --base ${FALLOW_AUDIT_BASE:-origin/main} --format compact --quiet",
		"dev": "./scripts/dev.sh",
		"dev:teardown": "docker compose down",
		"dev:docs": "turbo run dev --filter=@talqo/docs --ui=tui",
		"e2e": "turbo run e2e --output-logs=errors-only",
		"format": "bun fmt --check",
		"format:fix": "bun fmt",
		"i18n": "turbo run i18n --output-logs=errors-only",
		"i18n:fix": "turbo run i18n:fix --output-logs=errors-only",
		"lint": "oxlint --deny-warnings --report-unused-disable-directives .",
		"lint:fix": "oxlint --deny-warnings --report-unused-disable-directives --fix .",
		"pack:sdk": "bash scripts/pack-sdk.sh",
		"prepare": "husky",
		"push": "bash scripts/push-images.sh all",
		"push:docs": "bash scripts/push-images.sh docs",
		"push:talqo": "bash scripts/push-images.sh talqo",
		"quality": "turbo run lint format --output-logs=errors-only",
		"quality:fix": "turbo run lint:fix format:fix --output-logs=errors-only",
		"release": "bash scripts/release.sh",
		"test": "turbo run test --output-logs=errors-only",
		"test:integration": "turbo run test:integration --output-logs=errors-only",
		"test:mutation": "stryker run --ignoreStatic",
		"typecheck": "turbo run typecheck --output-logs=errors-only"
	},
	"devDependencies": {
		"@commitlint/cli": "^21.2.4",
		"@commitlint/config-conventional": "^21.2.4",
		"@fidasek009/stryker-mutator-bun-runner": "0.5.2",
		"@playwright/cli": "^0.1.23",
		"@shadcn/lint": "0.2.3",
		"@stryker-mutator/core": "10.1.1",
		"@tanstack/eslint-plugin-router": "1.162.0",
		"@types/bun": "1.4.4",
		"eslint-plugin-playwright": "2.12.1",
		"fallow": "3.42.0",
		"husky": "^9.1.7",
		"orval": "8.46.0",
		"oxlint": "1.90.0",
		"oxlint-tsgolint": "^7.0.2005",
		"supercov": "4.28.0",
		"turbo": "2.11.10"
	},
	"packageManager": "bun@1.4.4"
}
