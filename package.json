{
	"name": "talqo",
	"version": "0.0.1",
	"private": true,
	"workspaces": [
		"apps/*",
		"packages/*"
	],
	"type": "module",
	"scripts": {
		"actions:check": "actionlint && zizmor --offline .",
		"build": "turbo run build",
		"ci": "bun run actions:check && bun run contracts:check && bun run quality && bun run i18n && bun run typecheck && bun run test && bun run build",
		"contracts:check": "bun run contracts:generate && ! git status --porcelain -- apps/api/openapi.json apps/web/src/api/generated | grep .",
		"contracts:generate": "bun run --cwd apps/api openapi:generate && bunx oxfmt apps/api/openapi.json && bunx orval --config orval.config.ts --fail-on-warnings && bunx oxfmt apps/web/src/api/generated",
		"dev": "bun scripts/dev.ts",
		"dev:docs": "turbo run dev --filter=@talqo/docs --ui=tui",
		"e2e": "turbo run e2e --output-logs=errors-only",
		"format": "oxfmt --check",
		"format:fix": "oxfmt .",
		"i18n": "turbo run i18n --output-logs=errors-only",
		"i18n:fix": "turbo run i18n:fix --output-logs=errors-only",
		"lint": "oxlint --deny-warnings --report-unused-disable-directives .",
		"lint:fix": "oxlint --deny-warnings --report-unused-disable-directives --fix .",
		"prepare": "husky",
		"quality": "turbo run lint format --output-logs=errors-only",
		"quality:fix": "turbo run lint:fix format:fix --output-logs=errors-only",
		"test": "turbo run test --output-logs=errors-only",
		"test:integration": "turbo run test:integration --output-logs=errors-only",
		"typecheck": "turbo run typecheck --output-logs=errors-only"
	},
	"devDependencies": {
		"@commitlint/cli": "^21.2.2",
		"@commitlint/config-conventional": "^21.2.2",
		"@playwright/cli": "^0.1.18",
		"husky": "^9.1.7",
		"orval": "8.25.0",
		"oxfmt": "0.64.0",
		"oxlint": "1.79.0",
		"oxlint-tsgolint": "^7.0.2001",
		"turbo": "2.10.11"
	},
	"packageManager": "bun@1.3.14"
}
