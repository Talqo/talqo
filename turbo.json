{
	"$schema": "https://turborepo.com/schema.json",
	"tasks": {
		"//#format": {},
		"//#format:fix": {
			"cache": false,
			"dependsOn": ["//#lint:fix"]
		},
		"//#lint": {},
		"//#lint:fix": {
			"cache": false
		},
		"build": {
			"dependsOn": ["^build"],
			"outputs": ["dist/**"]
		},
		"dev": {
			"cache": false,
			"passThroughEnv": [
				"APP_SECRET",
				"DATABASE_URL",
				"NODE_ENV",
				"TALQO_API_PORT",
				"TALQO_CHAT_DAILY_MESSAGE_LIMIT",
				"TALQO_CHAT_MAX_CONCURRENT_GENERATIONS_PER_IP",
				"TALQO_TRUSTED_PROXY_CIDRS",
				"TALQO_RATE_LIMIT_IPV6_PREFIX_LENGTH",
				"TALQO_CHAT_MAX_INPUT_CHARACTERS",
				"TALQO_CHAT_MAX_OUTPUT_TOKENS",
				"TALQO_CHAT_GENERATION_TIMEOUT_SECONDS",
				"TALQO_WEB_PORT",
				"TALQO_WIDGET_PORT",
				"VITE_WIDGET_CDN_URL",
				"VITE_WIDGET_DEMO_API_URL",
				"VITE_WIDGET_PREVIEW_URL"
			],
			"persistent": true
		},
		"e2e": {
			"cache": false,
			"dependsOn": ["@talqo/widget#build"]
		},
		"test": {
			"dependsOn": ["^build"]
		},
		"test:integration": {
			"cache": false,
			"dependsOn": ["^build"]
		},
		"typecheck": {
			"dependsOn": ["^typecheck"]
		},
		"i18n": {},
		"i18n:fix": {},
		"@talqo/widget#test": {
			"dependsOn": ["^build", "build"]
		}
	}
}
