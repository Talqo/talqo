{
	"$schema": "https://turborepo.com/schema.json",
	"tasks": {
		"//#format": {},
		"//#format:fix": {
			"cache": false,
			"dependsOn": ["//#lint:fix"]
		},
		"//#lint": {},
		"//#lint:fix": {
			"cache": false
		},
		"build": {
			"dependsOn": ["^build"],
			"outputs": ["dist/**"]
		},
		"dev": {
			"cache": false,
			"passThroughEnv": [
				"DATABASE_URL",
				"NODE_ENV",
				"TALQO_API_PORT",
				"TALQO_WEB_PORT",
				"TALQO_WIDGET_PORT",
				"VITE_WIDGET_CDN_URL",
				"VITE_WIDGET_PREVIEW_URL"
			],
			"persistent": true
		},
		"e2e": {
			"cache": false,
			"dependsOn": ["@talqo/widget#build"],
			"passThroughEnv": ["DATABASE_URL", "TALQO_API_PORT", "TALQO_WEB_PORT"]
		},
		"test": {
			"dependsOn": ["^build"],
			"passThroughEnv": ["DATABASE_URL"]
		},
		"test:integration": {
			"cache": false,
			"dependsOn": ["^build"],
			"passThroughEnv": ["DATABASE_URL"]
		},
		"typecheck": {
			"dependsOn": ["^typecheck"]
		},
		"i18n": {},
		"i18n:fix": {},
		"@talqo/widget#test": {
			"dependsOn": ["^build", "build"]
		}
	}
}
