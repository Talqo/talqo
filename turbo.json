{
	"$schema": "https://turborepo.com/schema.json",
	"agentGuidance": false,
	"tasks": {
		"@talqo/api#dev:setup": {
			"cache": false,
			"passThroughEnv": ["APP_SECRET", "DATABASE_URL", "TALQO_*"]
		},
		"@talqo/api#dev": {
			"cache": false,
			"persistent": true,
			"dependsOn": ["dev:setup"],
			"passThroughEnv": ["APP_SECRET", "DATABASE_URL", "NODE_ENV", "TALQO_*"]
		},
		"@talqo/web#dev": {
			"cache": false,
			"persistent": true,
			"with": ["@talqo/api#dev", "@talqo/widget#dev"],
			"passThroughEnv": ["TALQO_API_PORT", "TALQO_WEB_PORT", "TALQO_WIDGET_PORT", "VITE_WIDGET_*"]
		},
		"@talqo/widget#dev": {
			"cache": false,
			"persistent": true,
			"passThroughEnv": ["TALQO_API_PORT", "TALQO_WIDGET_PORT", "VITE_WIDGET_*"]
		},
		"//#format": {},
		"//#format:fix": {
			"cache": false,
			"dependsOn": ["//#lint:fix"]
		},
		"//#lint": {},
		"//#lint:fix": {
			"cache": false
		},
		"build": {
			"dependsOn": ["^build"],
			"outputs": ["dist/**"]
		},
		"dev": {
			"cache": false,
			"persistent": true
		},
		"e2e": {
			"cache": false,
			"dependsOn": ["@talqo/widget#build", "@talqo/web#build"]
		},
		"test": {
			"dependsOn": ["transit"],
			"inputs": ["$TURBO_DEFAULT$", "!**/*.md"]
		},
		"test:integration": {
			"cache": false,
			"passThroughEnv": ["TALQO_TEST_WORKERS", "DOCKER_*", "TMPDIR"]
		},
		"typecheck": {
			"dependsOn": ["transit"],
			"inputs": ["$TURBO_DEFAULT$", "!**/*.md"]
		},
		"transit": {
			"dependsOn": ["^transit"],
			"inputs": ["$TURBO_DEFAULT$", "!**/*.md"]
		},
		"i18n": {},
		"i18n:fix": {},
		"@talqo/widget#test": {
			"dependsOn": ["^build", "build"]
		}
	}
}
