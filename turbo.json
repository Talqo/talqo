{
	"$schema": "https://turborepo.com/schema.json",
	"tasks": {
		"//#format": {},
		"//#format:fix": {
			"cache": false,
			"dependsOn": ["//#lint:fix"]
		},
		"//#lint": {},
		"//#lint:fix": {
			"cache": false
		},
		"build": {
			"dependsOn": ["^build"],
			"outputs": ["dist/**"]
		},
		"dev": {
			"cache": false,
			"passThroughEnv": ["DATABASE_URL", "TALQO_API_PORT", "TALQO_WEB_PORT", "TALQO_WIDGET_PORT"],
			"persistent": true
		},
		"e2e": {
			"cache": false,
			"dependsOn": ["@talqo/widget#build"]
		},
		"test": {
			"dependsOn": ["^build"]
		},
		"typecheck": {
			"dependsOn": ["^typecheck"]
		},
		"i18n": {},
		"i18n:fix": {}
	}
}
