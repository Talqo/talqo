{
	"$schema": "./node_modules/oxlint/configuration_schema.json",
	"ignorePatterns": [
		"**/.source/**",
		"**/routeTree.gen.ts",
		"**/api/generated/**",
		"packages/sdk/src/generated/**",
		"**/dist/**",
		"apps/**/vite-env.d.ts",
		".claude/**"
	],
	"plugins": ["import", "oxc", "typescript", "unicorn"],
	"jsPlugins": [
		"@shadcn/lint",
		{ "name": "@tanstack/router", "specifier": "@tanstack/eslint-plugin-router" },
		"eslint-plugin-playwright"
	],
	"settings": {
		"shadcn": {
			"ui": "@talqo/ui/components",
			"themeImports": ["^@talqo/ui/"]
		}
	},
	"options": {
		"typeAware": true
	},
	"categories": {
		"correctness": "error",
		"perf": "error",
		"suspicious": "error"
	},
	"rules": {
		"import/no-unassigned-import": ["error", { "allow": ["**/*.css"] }],
		"no-magic-numbers": [
			"error",
			{
				"ignore": [-1, 0, 1],
				"ignoreArrayIndexes": true,
				"ignoreDefaultValues": true,
				"ignoreEnums": true,
				"ignoreNumericLiteralTypes": true,
				"ignoreReadonlyClassProperties": true,
				"ignoreTypeIndexes": true
			}
		],
		"no-restricted-imports": [
			"error",
			{
				"paths": [
					{
						"name": "react",
						"importNames": ["*"],
						"message": "Replace `import * as React` with named imports: runtime APIs (`import { useId } from \"react\"`) and types (`import type { ReactNode } from \"react\"`)."
					}
				],
				"patterns": [
					{
						"group": ["../**"],
						"message": "Use @ alias imports instead of relative parent imports"
					}
				]
			}
		],
		"typescript/consistent-type-definitions": ["error", "type"],
		"typescript/consistent-type-imports": "error",
		// bun:test matchers return void by design; awaiting them is required under other runners.
		"typescript/await-thenable": "off",
		"typescript/no-array-delete": "error",
		"typescript/no-base-to-string": "error",
		"typescript/no-duplicate-type-constituents": "error",
		"typescript/no-floating-promises": "error",
		"typescript/no-for-in-array": "error",
		// The two `new Function` uses execute the built bundle in a sandbox for tests.
		"typescript/no-implied-eval": "off",
		"typescript/no-meaningless-void-operator": "error",
		"typescript/no-explicit-any": "error",
		"typescript/no-misused-promises": ["error", { "checksVoidReturn": { "attributes": false } }],
		"typescript/no-mixed-enums": "error",
		"typescript/no-redundant-type-constituents": "error",
		"typescript/no-unnecessary-qualifier": "error",
		"typescript/no-unnecessary-template-expression": "error",
		// Flags the vault generic (call sites specialize `T`) and explicit args bun's expect overloads require.
		"typescript/no-unnecessary-type-arguments": "off",
		"typescript/no-unnecessary-type-constraint": "error",
		"typescript/no-unnecessary-type-parameters": "off",
		"typescript/no-unsafe-argument": "error",
		"typescript/no-unsafe-assignment": "error",
		"typescript/no-unsafe-call": "error",
		"typescript/no-unsafe-declaration-merging": "error",
		"typescript/no-unsafe-enum-comparison": "error",
		"typescript/no-unsafe-member-access": "error",
		"typescript/no-unsafe-return": "error",
		// tsgolint flags every narrowing assertion, including `unknown as T`, deviating from typescript-eslint.
		"typescript/no-unsafe-type-assertion": "off",
		"typescript/no-unsafe-unary-minus": "error",
		"typescript/non-nullable-type-assertion-style": "error",
		"typescript/prefer-find": "error",
		"typescript/prefer-reduce-type-parameter": "error",
		"typescript/prefer-return-this-type": "error",
		"typescript/related-getter-setter-pairs": "error",
		"typescript/require-array-sort-compare": "error",
		"typescript/restrict-plus-operands": "error",
		"typescript/restrict-template-expressions": "error",
		"typescript/switch-exhaustiveness-check": "error",
		// Flags explicit `.call()` bindings and this-free closure factories passed to `useSyncExternalStore`.
		"typescript/unbound-method": "off",
		"no-restricted-globals": ["error", "close", "open", "print", "focus", "blur", "scroll", "status"]
	},
	"overrides": [
		{
			"files": ["**/*.test.{ts,tsx}", "**/*.spec.{ts,tsx}", "**/test-helpers.ts"],
			"rules": {
				"no-magic-numbers": "off"
			}
		},
		{
			"files": ["**/*.ts"],
			"rules": {
				"no-nested-ternary": "error"
			}
		},
		{
			"files": ["apps/{web,widget,docs}/src/**/*.{ts,tsx}", "packages/ui/src/**/*.{ts,tsx}"],
			"plugins": ["react"],
			"rules": {
				"react/rules-of-hooks": "error",
				"react/exhaustive-deps": "error"
			}
		},
		{
			"files": ["apps/**/*.tsx", "packages/**/*.tsx"],
			"plugins": ["react", "jsx-a11y"],
			"rules": {
				"react/function-component-definition": ["error", { "namedComponents": "function-declaration" }],
				"react/react-in-jsx-scope": "off",
				"react/iframe-missing-sandbox": "off",
				"react/forbid-elements": [
					"error",
					{
						"forbid": [
							{
								"element": "svg",
								"message": "Keep SVG artwork in .svg files and import it (vite-plugin-svgr or an icon component)."
							}
						]
					}
				]
			}
		},
		{
			"files": ["apps/{web,widget}/src/**/*.{ts,tsx}", "packages/ui/src/**/*.{ts,tsx}"],
			"rules": {
				"shadcn/no-restyle": ["error", { "allow": ["layout"] }],
				"shadcn/no-raw-colors": "error",
				"shadcn/no-arbitrary-values": ["error", { "allow": ["layout"] }],
				"shadcn/no-inline-styles": "error",
				"shadcn/no-unknown-classes": "error",
				"shadcn/require-static-classes": "error"
			}
		},
		{
			"files": ["packages/ui/src/components/**", "apps/widget/src/components/ui/**"],
			"rules": {
				// Component implementations own their appearance and variant functions.
				"shadcn/no-restyle": "off",
				"shadcn/no-arbitrary-values": "off",
				"shadcn/require-static-classes": "off"
			}
		},
		{
			"files": [
				"apps/web/src/features/statistics/components/agent-filter.tsx",
				"apps/web/src/routes/dashboard/index.tsx",
				"apps/web/src/routes/dashboard/agent.$agentId.tsx"
			],
			"rules": {
				// These swatches display operator-selected colors, not design tokens.
				"shadcn/no-inline-styles": ["error", { "allow": ["background", "background-color"] }]
			}
		},
		{
			"files": ["apps/web/src/features/embeds/components/widget-preview.tsx"],
			"rules": {
				"shadcn/no-inline-styles": ["error", { "allow": ["height", "transform", "transform-origin"] }]
			}
		},
		{
			"files": ["apps/widget/src/embedded-widget.tsx"],
			"rules": {
				"shadcn/no-inline-styles": ["error", { "allow": ["width", "height"] }]
			}
		},
		{
			"files": ["apps/widget/src/components/chat-feedback.tsx"],
			"rules": {
				"shadcn/no-inline-styles": ["error", { "allow": ["animation-delay"] }]
			}
		},
		{
			"files": ["apps/{web,docs}/src/**/*.{ts,tsx}"],
			"rules": {
				"@tanstack/router/create-route-property-order": "error",
				"@tanstack/router/route-param-names": "error"
			}
		},
		{
			"files": ["apps/e2e/**/*.ts"],
			"rules": {
				"playwright/expect-expect": "error",
				"playwright/missing-playwright-await": "error",
				"playwright/no-conditional-expect": "error",
				"playwright/no-conditional-in-test": "error",
				"playwright/no-duplicate-hooks": "error",
				"playwright/no-duplicate-slow": "error",
				"playwright/no-element-handle": "error",
				"playwright/no-eval": "error",
				"playwright/no-focused-test": "error",
				"playwright/no-force-option": "error",
				"playwright/no-identical-title": "error",
				"playwright/no-networkidle": "error",
				"playwright/no-page-pause": "error",
				"playwright/no-skipped-test": "error",
				"playwright/no-standalone-expect": "error",
				"playwright/no-unnecessary-assertions": "error",
				"playwright/no-unsafe-references": "error",
				"playwright/no-unused-locators": "error",
				"playwright/no-useless-await": "error",
				"playwright/no-useless-not": "error",
				"playwright/no-wait-for-navigation": "error",
				"playwright/no-wait-for-selector": "error",
				"playwright/no-wait-for-timeout": "error",
				"playwright/prefer-locator": "error",
				"playwright/prefer-to-have-count": "error",
				"playwright/prefer-to-have-length": "error",
				"playwright/prefer-web-first-assertions": "error",
				"playwright/require-annotation-reason": "error",
				"playwright/valid-describe-callback": "error",
				"playwright/valid-expect": "error",
				"playwright/valid-expect-in-promise": "error",
				"playwright/valid-test-tags": "error",
				"playwright/valid-title": "error"
			}
		},
		{
			"files": ["apps/widget/**"],
			"rules": {
				"no-restricted-imports": [
					"error",
					{
						"paths": [
							{
								"name": "lucide-react",
								"message": "The embed bundle must stay lean: import icons from src/assets/icons via vite-plugin-svgr instead."
							},
							{
								"name": "react",
								"importNames": ["*"],
								"message": "Replace `import * as React` with named imports: runtime APIs (`import { useId } from \"react\"`) and types (`import type { ReactNode } from \"react\"`)."
							}
						],
						"patterns": [
							{
								"group": ["../**"],
								"message": "Use @ alias imports instead of relative parent imports"
							}
						]
					}
				]
			}
		}
	]
}
