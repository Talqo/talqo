{
	"$schema": "https://unpkg.com/knip@6/schema-jsonc.json",
	"treatConfigHintsAsErrors": true,
	// These binaries are provided by developer and CI environments, not npm packages.
	"ignoreBinaries": ["actionlint", "zizmor"],
	// Used interactively by the repository-owned Playwright CLI skill.
	"ignoreDependencies": ["@playwright/cli"],
	"workspaces": {
		".": {
			"entry": ["*.ts", "scripts/**/*.ts"],
			"project": ["*.ts", "scripts/**/*.ts"],
		},
		"apps/api": {
			"project": ["src/**/*.ts", "*.ts"],
		},
		"apps/docs": {
			// Fumadocs loads this module by convention when compiling MDX.
			"entry": ["src/components/mdx.tsx"],
			"project": ["src/**/*.{ts,tsx,css}", "content/**/*.mdx", "*.ts"],
			"ignoreIssues": {
				// Fumadocs generates the collections/server virtual module in .source.
				"src/lib/source.ts": ["unlisted"],
			},
		},
		"apps/e2e": {
			// Playwright starts this process through webServer.command; its plugin adds the specs.
			"entry": ["tests/fake-provider.ts"],
			"project": ["**/*.ts"],
		},
		"apps/web": {
			// i18next-cli loads this configuration outside the application import graph.
			"entry": ["i18next.config.ts"],
			"project": ["src/**/*.{ts,tsx,css}", "*.ts", "!src/api/generated/**"],
		},
		"apps/widget": {
			// preview.html, Bun's SVG test plugin, and i18next-cli load these files externally.
			"entry": ["src/preview.tsx", "src/svg-stub-component.ts", "i18next.config.ts"],
			"project": ["src/**/*.{ts,tsx,css}", "*.ts"],
		},
		"packages/typescript-config": {
			// react-app.json references consumer-provided vite/client types.
			"ignoreDependencies": ["vite"],
		},
		"packages/ui": {
			// These patterns mirror the package's explicit wildcard subpath exports.
			"entry": ["src/components/*.tsx", "src/lib/*.ts"],
			"project": ["src/**/*.{ts,tsx,css}"],
		},
	},
}
